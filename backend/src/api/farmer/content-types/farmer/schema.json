{
    "kind": "collectionType",
    "collectionName": "farmers",
    "info": {
        "singularName": "farmer",
        "pluralName": "farmers",
        "displayName": "Farmer"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "farmer_code": {
            "type": "string",
            "required": true,
            "unique": true
        },
        "name": {
            "type": "string",
            "required": true
        },
        "farms": {
            "type": "relation",
            "relation": "manyToMany",
            "target": "api::farm.farm",
            "mappedBy": "farmers"
        },
        "parcels": {
            "type": "relation",
            "relation": "manyToMany",
            "target": "api::farm-parcel.farm-parcel",
            "mappedBy": "farmers"
        },
        "assistance_programs": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::assistance-program.assistance-program",
            "mappedBy": "farmer"
        },
        "contact": {
            "type": "string"
        },
        "farmer_status": {
            "type": "enumeration",
            "enum": ["Active", "Inactive", "Departed"]
        }
    }
}
