# Server-side Strapi URL (used by the Nitro proxy; keep private)
NUXT_STRAPI_URL=http://localhost:1337

# Browser-facing Strapi URL (used for media/photo URLs)
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Secures the sealed session cookie (nuxt-auth-utils).
# Generate one with: openssl rand -base64 43
NUXT_SESSION_PASSWORD=32-character-random-password

# You can generate your own api key at https://www.maptiler.com/
NUXT_PUBLIC_MAPTILER_KEY=your_maptiler_key
